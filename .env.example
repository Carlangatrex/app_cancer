# GEMINI_API_KEY: Required for Gemini AI API calls.
# Create your own key at https://aistudio.google.com/apikey
# IMPORTANT: Uncomment the line below if your app uses the Gemini API and set
# YOUR real key. Never commit a real key here: this file is the committed
# template, so it must contain only a placeholder. Keep the real key in .env
# (which is gitignored).
# If left commented out (or empty), the key will NOT be packaged in the APK.
GEMINI_API_KEY=